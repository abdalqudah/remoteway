# ---- Application ----
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# Long random string (at least 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Run pending database migrations automatically on start (useful on cPanel without SSH)
AUTO_MIGRATE=true

# ---- MySQL / MariaDB (cPanel -> MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_remoteway
DB_USER=cpaneluser_rwuser
DB_PASSWORD=
# Only used by `npm test`
DB_NAME_TEST=

# ---- First platform super admin (used once by `npm run seed`) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Admin
