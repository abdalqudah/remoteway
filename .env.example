# ---- Application ----
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
# Long random string (at least 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Run pending database migrations automatically on start (useful on cPanel without SSH)
AUTO_MIGRATE=true

# ---- MySQL / MariaDB (cPanel -> MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_remoteway
DB_USER=cpaneluser_rwuser
DB_PASSWORD=
# Only used by `npm test`
DB_NAME_TEST=

# ---- First platform super admin (used once by `npm run seed`) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Admin

# ---- File storage (documents) ----
# Uploaded files are kept OUTSIDE the app folder so re-uploading the app never deletes them.
# Default: the folder next to the app, e.g. /home/cpaneluser/remoteway-storage
# STORAGE_PATH=/home/cpaneluser/remoteway-storage

# ---- Email (optional; cPanel mailbox works) ----
# Without SMTP_HOST, invitations are shared as copy-able links and notifications stay in-app.
# SMTP_HOST=mail.your-domain.com
# SMTP_PORT=465
# SMTP_USER=no-reply@your-domain.com
# SMTP_PASSWORD=
# MAIL_FROM=RemoteWay <no-reply@your-domain.com>

# ---- Encryption key for stored credentials (gateway, SMTP, AI keys, 2FA secrets) ----
# 32+ random characters. Set it ONCE before entering any keys and never change it.
# APP_KEY=

# ---- Database backups ----
# Daily backups are saved OUTSIDE the app folder. Default: ../remoteway-updates/db-backups
# BACKUP_PATH=/home/cpaneluser/remoteway-backups

# ---- Privacy contact shown in the privacy policy (can also be set in Super Admin → Privacy & terms) ----
# PRIVACY_EMAIL=privacy@your-domain.com

# ---- Reverse proxy ----
# Default: trust X-Forwarded-For only from the local web server (cPanel Apache/LiteSpeed, Passenger).
# TRUST_PROXY=any  → trust one proxy hop from any address (load balancer on another machine)
# TRUST_PROXY=false → never trust X-Forwarded-For
# TRUST_PROXY=
