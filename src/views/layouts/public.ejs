<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head><%- include('../partials/head', { publicHead: true }) %></head>
<body class="site">
<header class="site-nav">
  <div class="inner">
    <a href="/" aria-label="RemoteWay"><%- include('../partials/logo') %></a>
    <% var H = (typeof site !== 'undefined' && site) ? site.header : null; %>
    <nav class="site-links" aria-label="<%= t('nav.main') %>">
      <% if (H) { H.items.forEach(function (n) { if (n.href && L(n.label)) { %><a href="<%= n.href %>"><%= L(n.label) %></a><% } }); } %>
    </nav>
    <div class="right">
      <a class="btn btn-ghost btn-sm" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>"><%- icon('languages') %><%= locale === 'ar' ? 'English' : 'العربية' %></a>
      <button class="btn btn-ghost btn-icon hide-sm" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
      <% if (currentUser) { %>
        <a class="btn btn-dark btn-sm" href="/app"><%= t('site.open_app') %></a>
      <% } else { %>
        <% if (!H || H.show_login !== 'no') { %><a class="btn btn-ghost btn-sm hide-sm" href="/login"><%= H ? L(H.login_label) : t('auth.login') %></a><% } %>
        <% if (!H || H.show_join !== 'no') { %><a class="btn btn-secondary btn-sm hide-sm" href="/join"><%= H ? L(H.join_label) : t('talent.join_cta') %></a><% } %>
        <% if (!H || L(H.signup_label)) { %><a class="btn btn-primary btn-sm" href="<%= H && H.signup_href ? H.signup_href : '/signup' %>"><%= H ? L(H.signup_label) : t('site.start_free') %></a><% } %>
      <% } %>
    </div>
  </div>
</header>
<main>
  <% if (typeof notice !== 'undefined' && notice) { %><div class="container mt-4"><div class="alert alert-success" role="status"><%- icon('circle-check') %><div><%= notice %></div></div></div><% } %>
  <% if (flash && flash.length) { %><div class="container mt-4"><%- include('../partials/flash') %></div><% } %>
  <%- body %>
</main>
<footer class="footer">
  <div class="container inner">
    <div class="row"><%- include('../partials/logo') %></div>
    <% var F = (typeof site !== 'undefined' && site) ? site.footer : null; %>
    <div class="row wrap small"><span>© <%= new Date().getFullYear() %> <%= F && F.copyright ? F.copyright : 'RemoteWay' %></span><% if (F ? L(F.tagline) : true) { %><span>·</span><span><%= F ? L(F.tagline) : t('site.footer_tagline') %></span><% } %></div>
    <nav class="row wrap small footer-links" aria-label="<%= t('legal.nav') %>"><% (F ? F.items : []).forEach(function (n) { if (n.href && L(n.label)) { %><a href="<%= n.href %>"><%= L(n.label) %></a><% } }) %></nav>
    <% var _soc = (typeof marketing !== 'undefined' && marketing && marketing.social) || {}; if (Object.keys(_soc).length) { %>
    <nav class="row wrap footer-social" aria-label="<%= t('seo.social_nav') %>"><% Object.keys(_soc).forEach(function (k) { %><a href="<%= _soc[k] %>" target="_blank" rel="noopener me" aria-label="<%= t('seo.social_' + k) %>" title="<%= t('seo.social_' + k) %>"><%- brandIcon(k) %></a><% }) %></nav>
    <% } %>
  </div>
</footer>
<% var _consentAsk = typeof pixelsOn !== 'undefined' && pixelsOn && !consent; %>
<% if (_consentAsk) { %>
<div class="cookie-note" role="region" aria-label="<%= t('legal.cookies') %>" data-cookie-note>
  <span><%- icon('cookie', 'icon-sm') %> <%= t('seo.consent_text') %> <a class="link" href="/privacy"><%= t('legal.more') %></a></span>
  <div class="row nowrap">
    <form method="post" action="/preferences/cookies"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="choice" value="decline"><button class="btn btn-secondary btn-sm" type="submit"><%= t('seo.consent_decline') %></button></form>
    <form method="post" action="/preferences/cookies"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="choice" value="accept"><button class="btn btn-dark btn-sm" type="submit"><%= t('seo.consent_accept') %></button></form>
  </div>
</div>
<% } else if (!cookiesOk && !(typeof pixelsOn !== 'undefined' && pixelsOn)) { %>
<div class="cookie-note" role="region" aria-label="<%= t('legal.cookies') %>" data-cookie-note>
  <span><%- icon('cookie', 'icon-sm') %> <%= t('legal.cookie_text') %> <a class="link" href="/privacy"><%= t('legal.more') %></a></span>
  <form method="post" action="/preferences/cookies"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-dark btn-sm" type="submit"><%= t('legal.cookie_ok') %></button></form>
</div>
<% } %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
</body>
</html>
