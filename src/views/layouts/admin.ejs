<% var _can = typeof adminCan === 'function' ? adminCan : function () { return false; }; %><!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>" data-v="<%= assetV %>"<% if (theme !== 'system') { %> data-theme="<%= theme %>"<% } %>>
<head><%- include('../partials/head') %></head>
<body>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><a href="/admin" aria-label="RemoteWay"><%- include('../partials/logo') %></a></div>
    <div class="org-switch" style="margin:12px"><div class="row" style="padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface-2)"><span class="org-mark"><%- icon('gauge', 'icon-sm') %></span><span><span class="org-name" style="display:block"><%= t('admin.title') %></span><span class="org-plan"><%= typeof platformRole !== 'undefined' && platformRole ? t('admin.role_' + platformRole) : t('admin.subtitle') %></span></span></div></div>
    <nav class="nav">
      <a href="/admin" class="<%= adminSection === 'overview' ? 'active' : '' %>"><%- icon('layout-dashboard') %><%= t('admin.overview') %></a>
      <% if (_can('crm')) { %><a href="/admin/crm" class="<%= adminSection === 'crm' ? 'active' : '' %>"><%- icon('users') %><%= t('crm.title') %></a><% } %>
      <% if (_can('organizations')) { %><a href="/admin/organizations" class="<%= adminSection === 'organizations' ? 'active' : '' %>"><%- icon('building-2') %><%= t('admin.organizations') %></a><% } %>
      <% if (_can('users')) { %><a href="/admin/users" class="<%= adminSection === 'users' ? 'active' : '' %>"><%- icon('user') %><%= t('admin.users') %></a><% } %>
      <% if (_can('plans')) { %><a href="/admin/plans" class="<%= adminSection === 'plans' ? 'active' : '' %>"><%- icon('layers') %><%= t('admin.plans') %></a><% } %>
      <% if (_can('invoices')) { %><a href="/admin/invoices" class="<%= adminSection === 'invoices' ? 'active' : '' %>"><%- icon('receipt') %><%= t('admin.invoices') %></a><% } %>
      <% if (_can('payments')) { %><a href="/admin/payments" class="<%= adminSection === 'payments' ? 'active' : '' %>"><%- icon('credit-card') %><%= t('admin.payments') %></a><% } %>
      <% if (_can('audit')) { %><a href="/admin/audit" class="<%= adminSection === 'audit' ? 'active' : '' %>"><%- icon('history') %><%= t('admin.audit') %></a><% } %>
      <% if (_can('email')) { %><a href="/admin/email" class="<%= adminSection === 'email' ? 'active' : '' %>"><%- icon('mail') %><%= t('admin.email') %></a><% } %>
      <% if (_can('support')) { %><a href="/admin/support" class="<%= adminSection === 'support' ? 'active' : '' %>"><%- icon('life-buoy') %><%= t('admin.support') %></a><% } %>
      <% if (_can('ai')) { %><a href="/admin/ai" class="<%= adminSection === 'ai' ? 'active' : '' %>"><%- icon('sparkles') %><%= t('admin.ai') %></a><% } %>
      <% if (_can('jobs')) { %><a href="/admin/jobs" class="<%= adminSection === 'jobs' ? 'active' : '' %>"><%- icon('zap') %><%= t('admin.jobs') %></a><% } %>
      <% if (_can('team')) { %><a href="/admin/team" class="<%= adminSection === 'team' ? 'active' : '' %>"><%- icon('user-cog') %><%= t('admin.team') %></a><% } %>
      <% if (_can('launch')) { %><a href="/admin/launch" class="<%= adminSection === 'launch' ? 'active' : '' %>"><%- icon('rocket') %><%= t('admin.launch') %></a><% } %>
      <% if (_can('site')) { %><a href="/admin/site" class="<%= adminSection === 'site' ? 'active' : '' %>"><%- icon('layout-dashboard') %><%= t('siteed.nav') %></a><% } %>
      <% if (_can('seo')) { %><a href="/admin/seo" class="<%= adminSection === 'seo' ? 'active' : '' %>"><%- icon('search') %><%= t('seo.nav') %></a><% } %>
      <% if (_can('marketing')) { %><a href="/admin/marketing" class="<%= adminSection === 'marketing' ? 'active' : '' %>"><%- icon('megaphone') %><%= t('seo.marketing_nav') %></a><% } %>
      <% if (_can('google')) { %><a href="/admin/google" class="<%= adminSection === 'google' ? 'active' : '' %>"><%- icon('log-in') %><%= t('google.admin_nav') %></a><% } %>
      <% if (_can('sandbox')) { %><a href="/admin/sandbox" class="<%= adminSection === 'sandbox' ? 'active' : '' %>"><%- icon('flask-conical') %><%= t('sandbox.nav') %></a><% } %>
      <% if (_can('domains')) { %><a href="/admin/domains" class="<%= adminSection === 'domains' ? 'active' : '' %>"><%- icon('globe') %><%= t('domains.nav') %></a><% } %>
      <% if (_can('legal')) { %><a href="/admin/legal" class="<%= adminSection === 'legal' ? 'active' : '' %>"><%- icon('scale') %><%= t('admin.legal') %></a><% } %>
      <% if (_can('backups')) { %><a href="/admin/backups" class="<%= adminSection === 'backups' ? 'active' : '' %>"><%- icon('database') %><%= t('admin.backups') %></a><% } %>
      <% if (_can('errors')) { %><a href="/admin/errors" class="<%= adminSection === 'errors' ? 'active' : '' %>"><%- icon('bug') %><%= t('admin.errors') %></a><% } %>
      <% if (_can('system')) { %><a href="/admin/system" class="<%= adminSection === 'system' ? 'active' : '' %>"><%- icon('package') %><%= t('admin.system') %></a><% } %>
      <div class="nav-group"><div class="nav-title"><%= t('admin.workspace') %></div><a href="/app"><%- icon('arrow-left', 'flip-rtl') %><%= t('admin.back_to_app') %></a></div>
    </nav>
  </aside>
  <div class="sidebar-backdrop" data-nav-close></div>
  <div class="main">
    <header class="topbar">
      <button class="btn btn-ghost btn-icon mobile-only" type="button" data-nav-toggle aria-label="<%= t('nav.menu') %>"><%- icon('menu') %></button>
      <span class="badge badge-brand"><%= t('admin.super_admin') %></span>
      <div class="topbar-actions">
        <a class="btn btn-ghost btn-sm" href="<%= langUrl(locale === 'ar' ? 'en' : 'ar') %>"><%- icon('languages') %><%= locale === 'ar' ? 'EN' : 'ع' %></a>
        <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="<%= t('common.toggle_theme') %>"><%- icon('moon', 'theme-moon') %><%- icon('sun', 'theme-sun hidden') %></button>
        <a class="btn btn-ghost btn-icon" href="/security" title="<%= t('auth.security_title') %>" aria-label="<%= t('auth.security_title') %>"><%- icon('shield-check') %></a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('log-out') %><%= t('auth.logout') %></button></form>
      </div>
    </header>
    <main class="content"><%- include('../partials/flash') %><% if (typeof appUrlWarning !== 'undefined' && appUrlWarning) { %><div class="alert alert-warning mb-6" role="alert"><%- icon('triangle-alert') %><div class="grow small"><div class="alert-title"><%= t('admin.app_url_title') %></div><div><%= t('admin.app_url_text', { current: appUrlWarning.current || '—', suggested: appUrlWarning.suggested }) %></div></div></div><% } %>
<%- body %></main>
  </div>
</div>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
</body>
</html>
