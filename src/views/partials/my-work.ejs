<% var _rv = today.reviews || { mine: [], toWrite: [] }; var _tr = today.training || []; var _pol = today.policies || []; if (_pol.length || _tr.length || (today.onboardingTasks && today.onboardingTasks.length) || (today.interviews && today.interviews.length) || _rv.mine.length || _rv.toWrite.length) { var tzf = function (v) { return new Intl.DateTimeFormat(locale === 'ar' ? 'ar-SA-u-nu-latn' : 'en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: organization.timezone }).format(new Date(v)); }; %>
<section class="panel">
  <div class="panel-head"><div><h2><%= t('dashboard.my_work') %></h2><div class="panel-sub"><%= t('dashboard.my_work_sub') %></div></div></div>
  <ul class="action-list">
    <% _pol.forEach(function (p) { %><li><a href="/app/documents/<%= p.id %>"><span class="action-icon warning"><%- icon('shield-check', 'icon-sm') %></span><span class="grow small"><%= t('compliance.todo_ack', { title: p.title }) %></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
    <% _tr.forEach(function (e) { var _d = e.due_date ? (e.due_date instanceof Date ? e.due_date.toISOString().slice(0, 10) : String(e.due_date).slice(0, 10)) : null; %><li><a href="/app/learning/courses/<%= e.course_id %>"><span class="action-icon <%= _d && _d < new Date().toISOString().slice(0, 10) ? 'danger' : '' %>"><%- icon('graduation-cap', 'icon-sm') %></span><span class="grow small"><%= t('learning.todo_course', { title: e.course_title }) %><span class="muted" style="display:block"><%= Math.round(Number(e.progress)) %>%<%= _d ? ' · ' + t('learning.due_on', { date: fmt.date(_d, { day: 'numeric', month: 'short' }) }) : '' %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
    <% _rv.mine.forEach(function (r) { %><li><a href="/app/performance/reviews/<%= r.id %>"><span class="action-icon warning"><%- icon('target', 'icon-sm') %></span><span class="grow small"><%= t('performance.todo_self', { cycle: r.cycle_name }) %></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
    <% _rv.toWrite.slice(0, 5).forEach(function (r) { %><li><a href="/app/performance/reviews/<%= r.id %>"><span class="action-icon info"><%- icon('user-check', 'icon-sm') %></span><span class="grow small"><%= t('performance.todo_manager', { name: r.first_name + ' ' + r.last_name }) %><span class="muted" style="display:block"><%= r.cycle_name %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
    <% (today.interviews || []).forEach(function (iv) { %>
      <li><a href="/app/recruitment/interviews/<%= iv.id %>"><span class="action-icon info"><%- icon('calendar-days', 'icon-sm') %></span><span class="grow small"><%= t('dashboard.interview_with', { name: iv.first_name + ' ' + iv.last_name }) %><span class="muted" style="display:block"><%= iv.job_title %> · <%= tzf(iv.scheduled_at) %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li>
    <% }) %>
    <% (today.onboardingTasks || []).slice(0, 6).forEach(function (tk) { var due = tk.due_date instanceof Date ? tk.due_date.toISOString().slice(0, 10) : String(tk.due_date || ''); %>
      <li><a href="/app/employee-onboarding/<%= tk.plan_id %>"><span class="action-icon <%= due && due < new Date().toISOString().slice(0, 10) ? 'warning' : '' %>"><%- icon('user-check', 'icon-sm') %></span><span class="grow small"><%= tk.title %><span class="muted" style="display:block"><%= t('dashboard.onboarding_for', { name: tk.first_name + ' ' + tk.last_name }) %><%= due ? ' · ' + fmt.date(due, { day: 'numeric', month: 'short' }) : '' %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li>
    <% }) %>
  </ul>
</section>
<% } %>
