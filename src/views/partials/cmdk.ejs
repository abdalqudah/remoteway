<div class="cmdk" data-cmdk role="dialog" aria-modal="true" aria-label="<%= t('search.open') %>">
  <div class="cmdk-box">
    <div class="cmdk-input"><%- icon('search', 'muted') %><input type="text" data-cmdk-input placeholder="<%= t('search.placeholder_long') %>" autocomplete="off" aria-label="<%= t('search.placeholder') %>"><span class="kbd">Esc</span></div>
    <div class="cmdk-results" data-cmdk-results></div>
  </div>
  <script type="application/json" data-cmdk-pages><%- JSON.stringify([
    { title: t('nav.dashboard'), href: '/app', icon: 'layout-dashboard' },
    can('employees.view') || can('team.view') ? { title: t('nav.employees'), href: '/app/employees', icon: 'users' } : null,
    can('employees.create') ? { title: t('employees.add'), href: '/app/employees/new', icon: 'user-plus' } : null,
    can('employees.view') ? { title: t('nav.structure'), href: '/app/structure', icon: 'building-2' } : null,
    hasFeature('attendance') ? { title: t('nav.attendance'), href: '/app/attendance', icon: 'calendar-check' } : null,
    hasFeature('leave') ? { title: t('nav.leave'), href: '/app/leave', icon: 'plane' } : null,
    hasFeature('leave') && can('leave.approve') ? { title: t('leave.tab_approvals'), href: '/app/leave?tab=approvals', icon: 'circle-check' } : null,
    hasFeature('documents') ? { title: t('nav.documents'), href: '/app/documents', icon: 'file-text' } : null,
    hasFeature('tasks') ? { title: t('nav.tasks'), href: '/app/tasks', icon: 'list-checks' } : null,
    hasFeature('recruitment') && can('recruitment.view') ? { title: t('nav.recruitment'), href: '/app/recruitment', icon: 'briefcase' } : null,
    hasFeature('recruitment') && can('recruitment.view') ? { title: t('recruitment.candidates'), href: '/app/recruitment/candidates', icon: 'users' } : null,
    hasFeature('recruitment') && can('recruitment.manage') ? { title: t('recruitment.new_job'), href: '/app/recruitment/jobs/new', icon: 'plus' } : null,
    hasFeature('recruitment') ? { title: t('recruitment.interviews'), href: '/app/recruitment/interviews', icon: 'calendar-days' } : null,
    hasFeature('onboarding') ? { title: t('nav.onboarding_module'), href: '/app/employee-onboarding', icon: 'user-check' } : null,
    hasFeature('learning') ? { title: t('nav.learning'), href: '/app/learning', icon: 'graduation-cap' } : null,
    hasFeature('learning') ? { title: t('learning.catalog'), href: '/app/learning/catalog', icon: 'search' } : null,
    hasFeature('performance') ? { title: t('nav.performance'), href: '/app/performance', icon: 'target' } : null,
    hasFeature('performance') ? { title: t('performance.new_goal'), href: '/app/performance/goals/new', icon: 'plus' } : null,
    hasFeature('payroll') && can('payroll.view') ? { title: t('nav.payroll'), href: '/app/payroll', icon: 'wallet' } : null,
    hasFeature('payroll') ? { title: t('payroll.my_payslips'), href: '/app/payroll/my', icon: 'receipt' } : null,
    can('employees.create') ? { title: t('import.title'), href: '/app/employees/import', icon: 'upload' } : null,
    { title: t('notifications.title'), href: '/app/notifications', icon: 'bell' },
    can('users.view') ? { title: t('settings.users'), href: '/app/settings/users', icon: 'user-cog' } : null,
    can('billing.view') ? { title: t('nav.billing'), href: '/app/billing', icon: 'receipt' } : null,
    { title: t('nav.settings'), href: '/app/settings', icon: 'settings' }
  ].filter(Boolean)).replace(/</g, '\\u003c') %></script>
  <script type="application/json" data-cmdk-i18n><%- JSON.stringify({ pages: t('search.pages'), employees: t('nav.employees'), departments: t('structure.departments'), jobs: t('recruitment.jobs'), candidates: t('recruitment.candidates'), empty: t('search.no_results') }).replace(/</g, '\\u003c') %></script>
</div>
