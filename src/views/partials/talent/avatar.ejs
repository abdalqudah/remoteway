<% var _s = typeof size !== 'undefined' ? size : 40; %><% if (p.photoUrl) { %><img class="t-avatar" src="<%= p.photoUrl %>" alt="" width="<%= _s %>" height="<%= _s %>" style="width:<%= _s %>px;height:<%= _s %>px"><% } else { %><span class="t-avatar t-avatar-initials" style="width:<%= _s %>px;height:<%= _s %>px;font-size:<%= Math.round(_s / 2.6) %>px"><%= initials(p.name || '?') %></span><% } %>
