<%
  var p = fullPath.split('?')[0];
  var isActive = function (href, exact) { return exact ? p === href : p.indexOf(href) === 0; };
%>
<div class="sidebar-brand"><a href="/app" aria-label="RemoteWay"><%- include('logo') %></a></div>
<details class="dropdown org-switch">
  <summary>
    <% if (typeof brand !== 'undefined' && brand && brand.logoUrl && !brand.whiteLabel) { %><span class="org-mark org-mark-logo"><img src="<%= brand.logoUrl %>" alt=""></span><% } else { %><span class="org-mark"><%= initials(organization.name) %></span><% } %>
    <span class="grow"><span class="org-name truncate" style="display:block"><%= organization.name %></span><span class="org-plan"><%= entitlements.plan ? entitlements.plan.name : '' %> · <%= t('billing.status_' + entitlements.status) %></span></span>
    <%- icon('chevrons-up-down', 'icon-sm muted') %>
  </summary>
  <div class="menu">
    <div class="menu-label"><%= t('nav.organizations') %></div>
    <% organizations.forEach(function (o) { %>
      <form method="post" action="/organizations/switch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= o.id %>">
        <button type="submit" class="<%= o.id === organization.id ? 'is-current' : '' %>"><span class="org-mark" style="width:22px;height:22px;font-size:10px;border-radius:6px"><%= initials(o.name) %></span><span class="grow truncate"><%= o.name %></span><% if (o.id === organization.id) { %><%- icon('check', 'icon-sm') %><% } %></button>
      </form>
    <% }) %>
    <div class="sep"></div>
    <a href="/organizations/new"><%- icon('plus', 'icon-sm') %><%= t('nav.new_organization') %></a>
  </div>
</details>
<%
  // Each link is shown when it applies to this person: a manager's permission, being an employee here
  // (linked employee record), having interviews or an onboarding plan. Modules outside the plan are shown
  // (locked) only to people who can change the plan.
  var canPlan = can('billing.view');
  var emp = typeof isEmployee !== 'undefined' && isEmployee;
  var item = function (key, href, ic, label, relevant, extraActive) {
    if (!relevant) return null;
    var on = hasFeature(key);
    if (!on && !canPlan) return null;
    return { href: href, icon: ic, label: label, locked: !on, active: isActive(href) || Boolean(extraActive) };
  };
  var workforce = [
    item('attendance', '/app/attendance', 'calendar-check', t('nav.attendance'), can('attendance.view') || can('attendance.manage') || emp),
    item('leave', '/app/leave', 'plane', t('nav.leave'), can('leave.view') || can('leave.approve') || emp),
    item('documents', '/app/documents', 'file-text', t('nav.documents'), can('documents.view') || can('documents.manage') || emp),
    item('tasks', '/app/tasks', 'list-checks', t('nav.tasks'), true, isActive('/app/projects')),
  ].filter(Boolean);
  var talent = [
    item('recruitment', '/app/recruitment', 'briefcase', t('nav.recruitment'), can('recruitment.view')),
    can('recruitment.view') ? null : item('recruitment', '/app/recruitment/interviews', 'briefcase', t('recruitment.my_interviews'), typeof hasInterviews !== 'undefined' && hasInterviews && hasFeature('recruitment')),
    item('talent_marketplace', '/app/talent', 'user-round-plus', t('talent.nav_find'), can('recruitment.view')),
    item('performance', '/app/performance', 'target', t('nav.performance'), can('performance.view') || can('performance.manage') || emp),
    item('learning', '/app/learning', 'graduation-cap', t('nav.learning'), can('learning.manage') || emp),
    item('onboarding', '/app/employee-onboarding', 'user-check', t('nav.onboarding_module'), can('onboarding.manage') || (typeof hasOnboardingPlan !== 'undefined' && hasOnboardingPlan)),
  ].filter(Boolean);
  var finance = [
    item('payroll', '/app/payroll', 'wallet', t('nav.payroll'), can('payroll.view')),
    item('payroll', '/app/payroll/my', 'receipt', t('payroll.my_payslips'), emp && hasFeature('payroll')),
  ].filter(Boolean);
  if (finance[0] && finance[0].href === '/app/payroll') finance[0].active = isActive('/app/payroll') && !isActive('/app/payroll/my');
  var insights = [
    can('automation.manage') ? item('automation', '/app/automation', 'zap', t('automation.title'), true) : null,
    can('compliance.view') ? item('compliance', '/app/compliance', 'shield-check', t('compliance.title'), true) : null,
    can('reports.view') ? item('analytics', '/app/analytics', 'chart-column', t('analytics.title'), true) : null,
    can('reports.view') ? { href: '/app/reports', icon: 'file-text', label: t('reports.title'), active: isActive('/app/reports') } : null,
    can('reports.view') ? { href: '/app/insights', icon: 'sparkles', label: t('ai.insights'), active: isActive('/app/insights'), locked: !(typeof aiStatus !== 'undefined' && aiStatus && aiStatus.areas.analytics.usable) } : null,
  ].filter(Boolean);
  var link = function (it) { return '<a href="' + it.href + '" class="' + (it.active ? 'active' : '') + (it.locked ? ' is-soon' : '') + '">' + icon(it.icon) + escapeHtml(it.label) + (it.locked ? '<span class="badge badge-soon">' + icon('lock', 'icon-sm') + '</span>' : '') + '</a>'; };
  var soon = function (grp) { return canPlan ? MODULES.filter(function (m) { return m.group === grp; }) : []; };
%>
<nav class="nav" aria-label="<%= t('nav.main') %>">
  <a href="/app" class="<%= isActive('/app', true) ? 'active' : '' %>"><%- icon('layout-dashboard') %><%= t('nav.dashboard') %></a>
  <div class="nav-group">
    <div class="nav-title"><%= t('nav.group_workforce') %></div>
    <% if (can('employees.view') || can('team.view')) { %><a href="/app/employees" class="<%= isActive('/app/employees') ? 'active' : '' %>"><%- icon('users') %><%= can('employees.view') ? t('nav.employees') : t('nav.my_team') %></a><% } %>
    <% if (can('employees.view')) { %><a href="/app/structure" class="<%= isActive('/app/structure') ? 'active' : '' %>"><%- icon('building-2') %><%= t('nav.structure') %></a><% } %>
    <% workforce.forEach(function (it) { %><%- link(it) %><% }) %>
  </div>
  <% [['talent', 'nav.group_talent', talent], ['finance', 'nav.group_finance', finance], ['insights', 'nav.group_insights', insights]].forEach(function (g) { var extra = soon(g[0]); if (!g[2].length && !extra.length) return; %>
  <div class="nav-group">
    <div class="nav-title"><%= t(g[1]) %></div>
    <% g[2].forEach(function (it) { %><%- link(it) %><% }) %>
    <% extra.forEach(function (m) { %>
      <a href="/app/modules/<%= m.key %>" class="is-soon <%= isActive('/app/modules/' + m.key) ? 'active' : '' %>"><%- icon(m.icon) %><%= t('nav.' + m.key) %><span class="badge badge-soon"><%= m.status === 'integration' ? t('common.setup_required') : t('common.soon') %></span></a>
    <% }) %>
  </div>
  <% }) %>
  <div class="nav-group">
    <div class="nav-title"><%= t('nav.group_admin') %></div>
    <% if (can('billing.view')) { %><a href="/app/billing" class="<%= isActive('/app/billing') ? 'active' : '' %>"><%- icon('receipt') %><%= t('nav.billing') %></a><% } %>
    <% if (can('support.manage')) { %><a href="/app/support" class="<%= isActive('/app/support') ? 'active' : '' %>"><%- icon('life-buoy') %><%= t('support.title') %></a><% } %>
    <a href="/app/settings" class="<%= isActive('/app/settings') ? 'active' : '' %>"><%- icon('settings') %><%= t('nav.settings') %></a>
    <% if (currentUser.is_super_admin) { %><a href="/admin"><%- icon('gauge') %><%= t('nav.super_admin') %></a><% } %>
  </div>
</nav>
<% if (entitlements.limits && entitlements.limits.employees !== undefined && can('billing.view')) { %>
<div class="sidebar-foot">
  <a class="plan-card" href="/app/billing" style="display:block">
    <div class="row between"><strong><%= entitlements.plan.name %></strong><span class="muted tiny"><%= t('billing.seats') %></span></div>
    <% var _max = entitlements.limits.employees; var _pct = _max ? Math.min(100, Math.round(seatUsage / _max * 100)) : 0; %>
    <div class="muted mt-1 tiny"><%= t('billing.employees_of', { used: fmt.number(seatUsage), max: _max === null ? '∞' : fmt.number(_max) }) %></div>
    <% if (_max) { %><div class="meter mt-2 <%= _pct >= 100 ? 'full' : _pct >= 90 ? 'warn' : '' %>"><span style="width:<%= _pct %>%"></span></div><% } %>
  </a>
</div>
<% } %>
