<% var d = s.data; %>
<section class="hero <%= secCls(s) %>" id="<%= s.anchor %>"><%- include('bg', { s: s }) %>
  <div class="container"><%- include('slot-open', { s: s }) %><div class="hero-grid">
    <div>
      <% if (L(d.eyebrow)) { %><span class="eyebrow-tag"><% if (d.eyebrow_icon) { %><%- icon(d.eyebrow_icon, 'icon-sm') %><% } %><%= L(d.eyebrow) %></span><% } %>
      <h1><%= L(d.title_1) %> <span class="accent"><%= L(d.title_accent) %></span><% if (L(d.title_3)) { %><br><%= L(d.title_3) %><% } %></h1>
      <% if (L(d.lead)) { %><p class="lead"><%= L(d.lead) %></p><% } %>
      <div class="cta">
        <% if (L(d.btn1_label) && d.btn1_href) { %><a class="btn btn-primary btn-lg" href="<%= d.btn1_href %>"><%= L(d.btn1_label) %><%- icon('arrow-right', 'flip-rtl') %></a><% } %>
        <% if (L(d.btn2_label) && d.btn2_href) { %><a class="btn btn-secondary btn-lg" href="<%= d.btn2_href %>"><%= L(d.btn2_label) %></a><% } %>
      </div>
      <% if (L(d.note)) { %><p class="muted small mt-4"><%= L(d.note) %></p><% } %>
    </div>
    <% var HD = s.design || {}; if (HD.media && HD.media_pos === 'panel') { %>
    <div class="hero-panel hero-panel-media"><%- include('media', { mid: HD.media, mode: HD.video_mode }) %></div>
    <% } else { %>
    <div class="hero-panel">
      <% if (L(d.panel_big)) { %><div style="font-weight:800;font-size:clamp(30px,4vw,46px);line-height:1;letter-spacing:-.02em;text-transform:uppercase;max-width:320px"><%= L(d.panel_big) %></div><% } %>
      <% if (L(d.panel_text)) { %><p class="mt-3" style="font-weight:600;max-width:360px"><%= L(d.panel_text) %></p><% } %>
      <% if ((d.items || []).length) { %><div class="lifecycle">
        <% d.items.forEach(function (c) { var on = c.highlight === 'yes'; %><span class="<%= on ? 'on' : '' %>" style="background:<%= on ? '#000' : 'rgba(255,255,255,.9)' %>;color:<%= on ? '#fff' : '#000' %>;border-color:transparent"><%= L(c.label) %></span><% }) %>
      </div><% } %>
      <% if (d.panel_tag) { %><div class="mt-6 small" style="font-weight:700"><%= d.panel_tag %></div><% } %>
    </div>
    <% } %>
  </div><%- include('slot-close', { s: s }) %></div>
</section>
