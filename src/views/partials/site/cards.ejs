<% var d = s.data; %>
<section class="section talent-cta-band <%= secCls(s) %>" id="<%= s.anchor %>"><%- include('bg', { s: s }) %>
  <div class="container"><%- include('slot-open', { s: s }) %>
    <%- include('head', { s: s }) %>
    <div class="grid grid-<%= Math.min(3, Math.max(1, (d.items || []).length)) %>" style="gap:24px">
      <% (d.items || []).forEach(function (c) { %>
      <div class="panel panel-body stack-sm"><% if (c.image) { %><div class="card-media"><%- include('media', { mid: c.image, alt: L(c.title) }) %></div><% } else if (c.icon) { %><span class="icon-wrap"><%- icon(c.icon) %></span><% } %><h3><%= L(c.title) %></h3><% if (L(c.text)) { %><p class="muted small"><%= L(c.text) %></p><% } %><% if (L(c.button_label) && c.button_href) { %><div><a class="btn btn-<%= c.style || 'primary' %>" href="<%= c.button_href %>"><%= L(c.button_label) %></a></div><% } %></div>
      <% }) %>
    </div>
  <%- include('slot-close', { s: s }) %></div>
</section>
