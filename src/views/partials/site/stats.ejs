<% var d = s.data; %>
<section class="section <%= secCls(s) %>" id="<%= s.anchor %>"><%- include('bg', { s: s }) %>
  <div class="container"><%- include('slot-open', { s: s }) %>
    <% if (L(d.title)) { %><div class="section-head"><h2><%= L(d.title) %></h2></div><% } %>
    <div class="site-stats">
      <% (d.items || []).forEach(function (x) { %><div class="site-stat"><strong dir="ltr"><%= x.value %></strong><span><%= L(x.label) %></span></div><% }) %>
    </div>
  <%- include('slot-close', { s: s }) %></div>
</section>
