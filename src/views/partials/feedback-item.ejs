<li><span class="dot"<%- f.kind === 'suggestion' ? ' style="background:var(--info)"' : '' %>></span><div class="grow">
  <div class="what"><strong><%= f.from_name || '—' %></strong> → <strong><%= f.first_name %> <%= f.last_name %></strong>
    <span class="st st-<%= f.kind === 'praise' ? 'approved' : 'in_progress' %>" style="margin-inline-start:6px"><%= t('performance.kind_' + f.kind) %></span><% if (f.visibility === 'private') { %> <span class="tiny muted"><%- icon('lock', 'icon-sm') %></span><% } %></div>
  <div class="small mt-1" style="white-space:pre-wrap" dir="auto"><%= f.body %></div>
  <div class="when"><%= fmt.date(f.created_at, { dateStyle: 'medium' }) %></div>
</div></li>
