<% var q = query; var qs = Object.keys(q).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&'); %>
<div class="page-head">
  <div><h1><%= t('nav.learning') %></h1><p><%= t(can('learning.manage') ? 'learning.reports_sub' : 'learning.reports_sub_team') %></p></div>
  <div class="page-actions"><a class="btn btn-secondary" href="/app/learning/reports/export.csv?<%= qs %>"><%- icon('download') %><%= t('common.export_csv') %></a></div>
</div>
<%- include('_nav') %>
<div class="kpis mb-6">
  <div class="kpi"><div class="kpi-label"><%= t('learning.kpi_enrollments') %></div><div class="kpi-value"><%= fmt.number(summary.total) %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('learning.kpi_completion') %></div><div class="kpi-value"><%= summary.rate %>%</div><div class="kpi-meta"><%= t('learning.completed_n', { n: fmt.number(summary.completed) }) %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('learning.kpi_overdue') %></div><div class="kpi-value" style="<%= summary.overdue ? 'color:var(--danger)' : '' %>"><%= fmt.number(summary.overdue) %></div><div class="kpi-meta"><a class="link" href="?overdue=1"><%= t('common.view_all') %></a></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('learning.kpi_expiring') %></div><div class="kpi-value" style="<%= summary.expiring ? 'color:var(--warning)' : '' %>"><%= fmt.number(summary.expiring) %></div><div class="kpi-meta"><%= t('learning.next_30_days') %></div></div>
</div>
<section class="panel">
  <form class="table-toolbar" method="get" data-autosubmit>
    <select class="select" name="course_id" aria-label="<%= t('learning.course') %>"><option value=""><%= t('learning.all_courses') %></option><% allCourses.forEach(function (c) { %><option value="<%= c.id %>"<%= String(q.course_id) === String(c.id) ? ' selected' : '' %>><%= c.title %></option><% }) %></select>
    <% if (departments.length && can('learning.manage')) { %><select class="select" name="department_id" aria-label="<%= t('fields.department') %>"><option value=""><%= t('learning.all_departments') %></option><% departments.forEach(function (d) { %><option value="<%= d.id %>"<%= String(q.department_id) === String(d.id) ? ' selected' : '' %>><%= d.name %></option><% }) %></select><% } %>
    <select class="select" name="status" aria-label="<%= t('fields.status') %>"><option value=""><%= t('learning.all_statuses') %></option><% ['not_started', 'in_progress', 'completed'].forEach(function (s) { %><option value="<%= s %>"<%= q.status === s ? ' selected' : '' %>><%= t('learning.status_' + s) %></option><% }) %></select>
    <label class="check"><input type="checkbox" name="overdue" value="1"<%= q.overdue === '1' ? ' checked' : '' %>><%= t('learning.only_overdue') %></label>
  </form>
  <% if (!rows.length) { %><div class="empty"><span class="empty-icon"><%- icon('chart-column') %></span><p><%= t('learning.no_enrollments') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('payroll.employee') %></th><th><%= t('learning.course') %></th><th><%= t('fields.status') %></th><th style="width:18%"><%= t('learning.progress') %></th><th class="num"><%= t('learning.score') %></th><th><%= t('learning.due') %></th></tr></thead>
    <tbody><% rows.forEach(function (r) { %>
      <tr><td><span class="person-name"><%= r.first_name %> <%= r.last_name %></span><div class="tiny muted"><%= r.department_name || '' %></div></td>
        <td><a class="link" href="/app/learning/courses/<%= r.course_id %>"><%= r.course_title %></a><div class="tiny muted"><%= t('learning.source_' + r.source) %></div></td>
        <td><span class="st st-<%= r.overdue ? 'rejected' : r.status === 'completed' ? 'approved' : r.status === 'in_progress' ? 'in_progress' : 'todo' %>"><%= r.overdue ? t('learning.overdue') : t('learning.status_' + r.status) %></span></td>
        <td><div class="row-sm"><div class="progress grow"><span style="width:<%= r.progress %>%"></span></div><span class="small"><%= Math.round(r.progress) %>%</span></div></td>
        <td class="num"><%= r.score !== null ? Math.round(Number(r.score)) + '%' : '—' %></td>
        <td class="nowrap small"><%= r.due_date ? fmt.date(r.due_date) : '—' %></td></tr>
    <% }) %></tbody>
  </table></div><% } %>
</section>
