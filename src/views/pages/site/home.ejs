<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow-tag"><%- icon('sparkles', 'icon-sm') %><%= t('site.eyebrow') %></span>
      <h1><%= t('site.hero_1') %> <span class="accent"><%= t('site.hero_2') %></span><br><%= t('site.hero_3') %></h1>
      <p class="lead"><%= t('site.hero_lead') %></p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href="/signup"><%= t('site.start_free') %><%- icon('arrow-right', 'flip-rtl') %></a>
        <a class="btn btn-secondary btn-lg" href="mailto:Info@remoteway.com?subject=RemoteWay%20Demo"><%= t('site.book_demo') %></a>
      </div>
      <p class="muted small mt-4"><%= t('site.hero_note') %></p>
    </div>
    <div class="hero-panel" id="platform">
      <div style="font-weight:800;font-size:clamp(30px,4vw,46px);line-height:1;letter-spacing:-.02em;text-transform:uppercase" dir="ltr">From<br>Anywhere.</div>
      <p class="mt-3" style="font-weight:600;max-width:360px"><%= t('site.panel_text') %></p>
      <div class="lifecycle">
        <% ['recruit','hire','onboard','manage','track','pay','evaluate','develop','retain'].forEach(function (k, i) { %><span class="<%= i === 3 ? 'on' : '' %>" style="background:<%= i === 3 ? '#000' : 'rgba(255,255,255,.9)' %>;color:<%= i === 3 ? '#fff' : '#000' %>;border-color:transparent"><%= t('site.life_' + k) %></span><% }) %>
      </div>
      <div class="mt-6 small" style="font-weight:700">#REMOTE WAY</div>
    </div>
  </div>
</section>

<section class="section" id="modules">
  <div class="container">
    <div class="section-head"><h2><%= t('site.modules_title') %></h2><p><%= t('site.modules_lead') %></p></div>
    <div class="module-grid">
      <% [
        ['users', 'workforce', true], ['briefcase', 'recruitment', false], ['wallet', 'payroll', false],
        ['target', 'performance', false], ['graduation-cap', 'learning', false], ['calendar-check', 'attendance', false],
        ['layers', 'subscription', true], ['shield-check', 'rbac', true], ['sparkles', 'ai', false]
      ].forEach(function (m) { %>
      <div class="module">
        <div class="row between"><span class="icon-wrap"><%- icon(m[0]) %></span><span class="badge <%= m[2] ? 'badge-success' : '' %>"><%= m[2] ? t('site.available_now') : t('common.soon') %></span></div>
        <h3><%= t('site.mod_' + m[1] + '_title') %></h3>
        <p><%= t('site.mod_' + m[1] + '_text') %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" id="integrations">
  <div class="container grid grid-2" style="align-items:center;gap:48px">
    <div class="section-head" style="margin:0"><h2><%= t('site.integrations_title') %></h2><p><%= t('site.integrations_lead') %></p></div>
    <div class="stack-sm">
      <% [['credit-card','payway'],['mail','email'],['zap','sms'],['receipt','accounting'],['plug','api']].forEach(function (i) { %>
      <div class="integration"><span class="logo-box"><%- icon(i[0]) %></span><div class="grow"><strong><%= t('site.int_' + i[1]) %></strong><div class="muted small"><%= t('site.int_' + i[1] + '_text') %></div></div><span class="badge"><%= i[1] === 'api' ? t('site.available_now') : t('common.soon') %></span></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" id="security">
  <div class="container">
    <div class="section-head"><h2><%= t('site.security_title') %></h2><p><%= t('site.security_lead') %></p></div>
    <div class="grid grid-3">
      <% [['lock','isolation'],['user-cog','rbac'],['history','audit'],['key-round','secrets'],['shield-check','web'],['globe','locale']].forEach(function (s) { %>
      <div class="panel panel-body"><span class="icon-wrap" style="width:36px;height:36px;border-radius:10px;background:var(--accent-soft);display:inline-flex;align-items:center;justify-content:center"><%- icon(s[0]) %></span><h3 class="mt-3"><%= t('site.sec_' + s[1]) %></h3><p class="muted small mt-1"><%= t('site.sec_' + s[1] + '_text') %></p></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" id="pricing">
  <div class="container">
    <div class="section-head"><h2><%= t('site.pricing_title') %></h2><p><%= t('site.pricing_lead') %></p></div>
    <%- include('../../partials/pricing-cards') %>
  </div>
</section>

<section class="section faq" id="faq">
  <div class="container" style="max-width:820px">
    <div class="section-head"><h2><%= t('site.faq_title') %></h2></div>
    <% [1,2,3,4,5].forEach(function (i) { %>
      <details><summary><%= t('site.faq_q' + i) %><%- icon('plus', 'icon-sm') %></summary><p><%= t('site.faq_a' + i) %></p></details>
    <% }) %>
  </div>
</section>

<section class="section" style="border-top:0;padding-top:0">
  <div class="container">
    <div class="cta-band">
      <h2><%= t('site.cta_1') %> <span><%= t('site.cta_2') %></span></h2>
      <div class="row wrap"><a class="btn btn-primary btn-lg" href="/signup"><%= t('site.start_free') %></a><a class="btn btn-lg" style="background:#fff;color:#000" href="/pricing"><%= t('site.see_pricing') %></a></div>
    </div>
  </div>
</section>
