<% var compDialog = function (x, id) { %>
<dialog class="dialog" id="<%= id %>"<%= openDialog === id ? ' data-open-on-load' : '' %>>
  <form method="post" action="/app/performance/competencies<%= x.id ? '/' + x.id : '' %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="dialog-head"><h2><%= x.id ? t('performance.edit_competency') : t('performance.new_competency') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <div class="form-grid">
        <div class="field"><label class="label" for="<%= id %>-n"><%= t('payroll.name_en') %><span class="req">*</span></label><input class="input" id="<%= id %>-n" name="name" maxlength="120" required value="<%= x.name || '' %>"></div>
        <div class="field"><label class="label" for="<%= id %>-a"><%= t('payroll.name_ar') %></label><input class="input" id="<%= id %>-a" name="name_ar" dir="rtl" maxlength="120" value="<%= x.name_ar || '' %>"></div>
      </div>
      <div class="field"><label class="label" for="<%= id %>-d"><%= t('fields.description') %></label><input class="input" id="<%= id %>-d" name="description" maxlength="500" value="<%= x.description || '' %>"></div>
      <% if (x.id) { %><label class="check"><input type="checkbox" name="is_active"<%= x.is_active ? ' checked' : '' %>><%= t('payroll.active') %></label><% } %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-dark" type="submit"><%= t('common.save') %></button></div>
  </form>
</dialog>
<% }; %>
<div class="page-head">
  <div><h1><%= t('nav.performance') %></h1><p><%= t('performance.cycles_sub') %></p></div>
  <% if (perfAdmin) { %><div class="page-actions"><button class="btn btn-dark" type="button" data-open-dialog="cycle-dialog"><%- icon('plus') %><%= t('performance.new_cycle') %></button></div><% } %>
</div>
<%- include('_nav') %>
<div class="grid grid-3">
  <section class="panel span-2">
    <div class="panel-head"><h2><%= t('performance.cycles') %></h2></div>
    <% if (!cycles.length) { %><div class="empty"><span class="empty-icon"><%- icon('badge-check') %></span><h3><%= t('performance.no_cycles_title') %></h3><p><%= t('performance.no_cycles_text') %></p></div><% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= t('performance.cycle') %></th><th><%= t('fields.status') %></th><th><%= t('performance.period') %></th><th style="width:28%"><%= t('performance.completion') %></th></tr></thead>
      <tbody><% cycles.forEach(function (c) { %>
        <tr><td><a class="person-name" href="/app/performance/cycles/<%= c.id %>"><%= c.name %></a><div class="tiny muted"><%= t('performance.kind_cycle_' + c.kind) %></div></td>
          <td><span class="st st-<%= c.status === 'active' ? 'in_progress' : c.status %>"><%= t('performance.cycle_status_' + c.status) %></span></td>
          <td class="nowrap small"><%= fmt.date(c.period_start) %> – <%= fmt.date(c.period_end) %></td>
          <td><% if (c.total) { %><div class="row-sm"><div class="progress grow"><span style="width:<%= c.completedPct %>%"></span></div><span class="small nowrap"><%= c.counts.completed || 0 %>/<%= c.total %></span></div><% } else { %>—<% } %></td></tr>
      <% }) %></tbody>
    </table></div><% } %>
  </section>
  <section class="panel" id="competencies">
    <div class="panel-head"><div><h2><%= t('performance.competencies') %></h2><div class="panel-sub"><%= t('performance.competencies_sub') %></div></div><% if (perfAdmin) { %><button class="btn btn-secondary btn-sm" type="button" data-open-dialog="competency-new" aria-label="<%= t('performance.new_competency') %>"><%- icon('plus', 'icon-sm') %></button><% } %></div>
    <ul class="action-list"><% competencies.forEach(function (x) { %>
      <li><div style="display:flex;gap:12px;align-items:center;padding:12px 20px"><span class="grow small<%= x.is_active ? '' : ' muted' %>"><strong><%= locale === 'ar' && x.name_ar ? x.name_ar : x.name %></strong><% if (x.description) { %><span class="muted" style="display:block"><%= x.description %></span><% } %></span>
        <% if (perfAdmin) { %><button class="btn btn-ghost btn-sm btn-icon" type="button" data-open-dialog="competency-<%= x.id %>" aria-label="<%= t('common.edit') %>"><%- icon('pencil', 'icon-sm') %></button><% } %></div></li>
    <% }) %></ul>
  </section>
</div>
<% if (perfAdmin) { %>
<dialog class="dialog" id="cycle-dialog"<%= openDialog === 'cycle' ? ' data-open-on-load' : '' %>>
  <form method="post" action="/app/performance/cycles" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="dialog-head"><div><h2><%= t('performance.new_cycle') %></h2><p class="muted small mt-1"><%= t('performance.new_cycle_sub') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack"><%- include('../../partials/cycle-form', { c: {} }) %></div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-dark" type="submit"><%= t('performance.save_draft') %></button></div>
  </form>
</dialog>
<% compDialog({}, 'competency-new'); competencies.forEach(function (x) { compDialog(x, 'competency-' + x.id); }); %>
<% } %>
