<%
  var c = cycle; var maxDist = Math.max.apply(null, c.distribution.concat([1]));
  var statusOf = function (r) { return r.status === 'completed' ? 'approved' : r.status === 'manager_review' ? 'review' : 'pending'; };
%>
<div class="page-head">
  <div>
    <div class="eyebrow"><a href="/app/performance/cycles"><%= t('performance.reviews') %></a></div>
    <h1><%= c.name %></h1>
    <div class="row-sm wrap mt-2 small muted"><span class="st st-<%= c.status === 'active' ? 'in_progress' : c.status %>"><%= t('performance.cycle_status_' + c.status) %></span><span><%= fmt.date(c.period_start) %> – <%= fmt.date(c.period_end) %></span><span><%= t('performance.weights', { goals: c.goals_weight, comps: 100 - c.goals_weight }) %></span></div>
  </div>
  <% if (perfAdmin) { %><div class="page-actions">
    <% if (c.status === 'draft') { %>
      <button class="btn btn-secondary" type="button" data-open-dialog="cycle-dialog"><%- icon('pencil') %><%= t('common.edit') %></button>
      <form method="post" action="/app/performance/cycles/<%= c.id %>/delete" data-confirm="<%= t('performance.confirm_delete_cycle') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger-ghost" type="submit" aria-label="<%= t('common.delete') %>"><%- icon('trash-2') %></button></form>
      <form method="post" action="/app/performance/cycles/<%= c.id %>/launch" data-confirm="<%= t('performance.confirm_launch', { n: preview }) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-dark" type="submit"<%= preview ? '' : ' disabled' %>><%- icon('rocket') %><%= t('performance.launch') %></button></form>
    <% } else if (c.status === 'active') { %>
      <form method="post" action="/app/performance/cycles/<%= c.id %>/close" data-confirm="<%= t('performance.confirm_close') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-dark" type="submit"><%- icon('lock') %><%= t('performance.close_cycle') %></button></form>
    <% } %>
  </div><% } %>
</div>

<% if (c.status === 'draft') { %>
  <div class="alert alert-info mb-6"><%- icon('info') %><div><%= t('performance.draft_cycle_note', { n: preview }) %></div></div>
<% } else { %>
<div class="grid grid-3 mb-6">
  <div class="kpis span-2" style="grid-template-columns:repeat(3,minmax(0,1fr))">
    <div class="kpi"><div class="kpi-label"><%= t('performance.status_self_review') %></div><div class="kpi-value"><%= fmt.number(c.counts.self_review || 0) %></div></div>
    <div class="kpi"><div class="kpi-label"><%= t('performance.status_manager_review') %></div><div class="kpi-value"><%= fmt.number(c.counts.manager_review || 0) %></div></div>
    <div class="kpi"><div class="kpi-label"><%= t('performance.status_completed') %></div><div class="kpi-value"><%= fmt.number(c.counts.completed || 0) %></div><div class="kpi-meta"><%= c.completedPct %>%</div></div>
  </div>
  <section class="panel"><div class="panel-head"><h2><%= t('performance.distribution') %></h2></div>
    <div class="panel-body"><div class="dist" role="img" aria-label="<%= t('performance.distribution') %>">
      <% c.distribution.forEach(function (v, i) { %><div class="dist-col"><span class="small"><%= v %></span><span class="dist-bar" style="height:<%= Math.round(v / maxDist * 100) %>%"></span><span class="tiny muted"><%= i + 1 %>★</span></div><% }) %>
    </div></div></section>
</div>
<section class="panel">
  <div class="panel-head"><h2><%= t('performance.reviews') %></h2></div>
  <% if (!c.reviews.length) { %><div class="empty"><p><%= t('performance.no_reviews') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('payroll.employee') %></th><th><%= t('performance.reviewer') %></th><th><%= t('fields.status') %></th><th class="num"><%= t('performance.score') %></th><th></th></tr></thead>
    <tbody><% c.reviews.forEach(function (r) { %>
      <tr><td><span class="person"><span class="avatar"><%= initials(r.first_name + ' ' + r.last_name) %></span><span><span class="person-name"><%= r.first_name %> <%= r.last_name %></span><span class="person-sub" style="display:block"><%= r.job_title || '' %><%= r.department_name ? ' · ' + r.department_name : '' %></span></span></span></td>
        <td class="small"><%= r.reviewer_name || '—' %></td>
        <td><span class="st st-<%= statusOf(r) %>"><%= t('performance.status_' + r.status) %></span><% if (r.acknowledged_at) { %> <span class="tiny muted"><%- icon('check', 'icon-sm') %></span><% } %></td>
        <td class="num"><% if (r.final_rating) { %><strong><%= r.final_rating %></strong><span class="tiny muted"> (<%= Number(r.final_score).toFixed(2) %>)</span><% } else { %>—<% } %></td>
        <td class="text-end"><a class="btn btn-secondary btn-sm" href="/app/performance/reviews/<%= r.id %>"><%= t('recruitment.open') %></a></td></tr>
    <% }) %></tbody>
  </table></div><% } %>
</section>
<% } %>
<% if (perfAdmin && c.status === 'draft') { %>
<dialog class="dialog" id="cycle-dialog"<%= openDialog === 'cycle' ? ' data-open-on-load' : '' %>>
  <form method="post" action="/app/performance/cycles/<%= c.id %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="dialog-head"><h2><%= t('performance.edit_cycle') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack"><%- include('../../partials/cycle-form', { c: c }) %></div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-dark" type="submit"><%= t('common.save_changes') %></button></div>
  </form>
</dialog>
<% } %>
