<h1><%= t('empacc.choose_title') %></h1>
<p class="lead"><%= t('empacc.choose_lead') %></p>
<form method="post" action="/security/new-password" class="stack mt-6" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../../partials/field', { name: 'new_password', label: t('empacc.your_password'), type: 'password', required: true, autocomplete: 'new-password', help: t('auth.password_help'), attrs: 'minlength="8"' }) %>
  <%- include('../../partials/field', { name: 'new_password_confirm', label: t('empacc.confirm_password'), type: 'password', required: true, autocomplete: 'new-password' }) %>
  <button class="btn btn-dark btn-lg btn-block" type="submit"><%= t('empacc.save_continue') %><%- icon('arrow-right', 'flip-rtl') %></button>
</form>
<form method="post" action="/logout" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('log-out') %><%= t('auth.logout') %></button></form>
