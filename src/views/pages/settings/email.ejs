<%
  var o = old || {}; var posted = o._csrf !== undefined && o.host !== undefined;
  var c = cfg || {};
  var v = function (k, d) { return posted ? (o[k] || '') : (c[k] !== undefined && c[k] !== null ? c[k] : (d || '')); };
%>
<div class="page-head"><div><h1><%= t('nav.settings') %></h1><p><%= t('orgmail.sub') %></p></div></div>
<%- include('../../partials/settings-nav') %>

<% if (!cfg || !cfg.enabled) { %>
<div class="alert <%= required ? 'alert-warning' : 'alert-info' %> mb-6" role="alert"><%- icon('mail') %><div class="grow">
  <div class="alert-title"><%= required ? t('orgmail.required_title') : t('orgmail.optional_title') %></div>
  <div class="text-2 small"><%= required ? t('orgmail.required_text') : t('orgmail.optional_text') %></div></div></div>
<% } %>

<%- include('../../partials/smtp-result') %>
<% if (cfg && cfg.last_error && !(typeof testResult !== 'undefined' && testResult)) { %><div class="alert alert-error mb-6"><%- icon('circle-alert') %><div class="small"><div class="alert-title"><%= t('orgmail.status_failed') %></div><%= cfg.last_error %></div></div><% } %>
<div class="grid grid-3 align-start">
  <div class="span-2">
    <div class="row between mb-2"><span class="badge <%= cfg && cfg.enabled ? 'badge-success' : cfg ? 'badge-warning' : '' %>"><%= cfg && cfg.enabled ? t('orgmail.status_on') : cfg ? t('orgmail.status_failed') : t('orgmail.status_none') %></span>
      <% if (cfg) { %><button class="btn btn-danger-ghost btn-sm" type="submit" form="mail-remove"><%= t('orgmail.remove') %></button><% } %></div>
    <%- include('../../partials/smtp-form', { base: '/app/settings/email', cfg: cfg, testTo: currentUser.email, showClear: false }) %>
    <p class="small muted mt-2"><%= t('orgmail.save_note') %></p>
  </div>
  <section class="panel">
    <div class="panel-head"><h2><%- icon('info') %> <%= t('orgmail.how_title') %></h2></div>
    <div class="panel-body stack-sm small">
      <p><strong><%= t('smtp.p_gmail') %>:</strong> <%= t('smtp.g_gmail') %></p>
      <p><strong><%= t('smtp.p_google_relay') %>:</strong> <%= t('smtp.g_google_relay') %></p>
      <p><strong><%= t('smtp.p_microsoft365') %>:</strong> <%= t('smtp.g_microsoft365') %></p>
      <p><strong><%= t('smtp.p_cpanel') %>:</strong> <%= t('smtp.g_cpanel') %></p>
      <p class="muted"><%= t('orgmail.what_uses') %></p>
      <p class="muted"><%= t('orgmail.account_note') %></p>
    </div>
  </section>
</div>
<%- include('../../partials/smtp-events') %>
<% if (cfg) { %><form id="mail-remove" method="post" action="/app/settings/email/remove" data-confirm="<%= t('orgmail.remove_confirm') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %>
