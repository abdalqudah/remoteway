<% var i = invoice; %>
<div class="page-head">
  <div><div class="eyebrow"><a href="/app/billing"><%= t('nav.billing') %></a><%- icon('chevron-right', 'icon-sm flip-rtl') %></div><h1><%= t('billing.invoice') %> <span class="mono"><%= i.number %></span></h1></div>
  <div class="page-actions"><button class="btn btn-secondary" type="button" data-print><%- icon('download') %><%= t('billing.print') %></button></div>
</div>
<% if (paymentResult) { var pr = paymentResult === 'paid' ? ['success', 'circle-check', 'paid'] : paymentResult === 'initiated' ? ['info', 'clock', 'checking'] : ['error', 'circle-x', 'not_completed']; %>
<div class="alert alert-<%= pr[0] %> mb-6 no-print" role="status" style="max-width:860px"><%- icon(pr[1]) %><div><div class="alert-title"><%= t('payments.result_' + pr[2]) %></div><div class="small text-2"><%= t('payments.result_' + pr[2] + '_text') %></div></div></div>
<% } %>
<% if (i.status === 'issued' && gateways.length && can('billing.manage')) {
  var options = [];
  gateways.forEach(function (g) {
    if (g.methods) g.methods.forEach(function (m) { options.push({ value: g.key + ':' + m, label: t('payments.method_' + m) + ' · ' + g.label }); });
    else options.push({ value: g.key, label: g.label });
  }); %>
<form class="panel mb-6 no-print pay-panel" method="post" action="/app/billing/invoices/<%= i.id %>/pay" style="max-width:860px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="panel-body stack">
    <% if (formError) { %><div class="alert alert-error"><%- icon('circle-alert') %><div class="grow small"><% if (formError.code === 'PAYMENT_GATEWAY_ERROR') { %><%= t('payments.gateway_error') %> <span class="muted" dir="ltr"><%= formError.message %></span><% } else { %><%= Object.values(errors)[0] || formError.message %><% } %></div></div><% } %>
    <div class="row between wrap">
      <div><h2 class="section-title"><%= t('payments.pay_online') %></h2><div class="muted small"><%= t('payments.pay_online_sub') %></div></div>
      <div class="num" style="font-weight:800;font-size:20px"><%= fmt.money(i.total, i.currency) %></div>
    </div>
    <% if (options.length > 1) { %>
    <fieldset class="field"><legend class="label"><%= t('payments.choose') %></legend>
      <div class="row-sm wrap"><% options.forEach(function (o, idx) { %>
        <label class="check provider-choice"><input type="radio" name="gateway" value="<%= o.value %>"<%= idx === 0 ? ' checked' : '' %>><%= o.label %></label>
      <% }) %></div>
    </fieldset>
    <% } else { %><input type="hidden" name="gateway" value="<%= options[0].value %>"><% } %>
    <div class="row between wrap">
      <span class="muted small"><%- icon('lock', 'icon-sm') %> <%= t('payments.secure_note') %></span>
      <button class="btn btn-primary" type="submit" data-busy-label="<%= t('payments.starting') %>"><%- icon('credit-card') %><%= t('payments.pay_now', { amount: fmt.money(i.total, i.currency) }) %></button>
    </div>
  </div>
</form>
<% } %>
<section class="panel" style="max-width:860px">
  <div class="panel-body stack-lg">
    <div class="row between wrap" style="align-items:flex-start">
      <div><span class="invoice-logo"><%- include('../../partials/logo') %></span><div class="muted small mt-3">remoteway.com · Info@remoteway.com</div></div>
      <div class="text-end"><span class="badge badge-dot <%= i.status === 'paid' ? 'badge-success' : 'badge-warning' %>"><%= t('billing.invoice_' + i.status) %></span><div class="small mt-2"><%= t('billing.date') %>: <%= fmt.date(i.issue_date) %></div><div class="small"><%= t('billing.due') %>: <%= fmt.date(i.due_date) %></div></div>
    </div>
    <div><div class="label"><%= t('billing.bill_to') %></div><div style="font-weight:700"><%= organization.name %></div><div class="muted small"><%= organization.address || '' %> <%= locale === 'ar' ? organization.country_name_ar : organization.country_name %></div></div>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= t('fields.description') %></th><th class="text-end"><%= t('billing.quantity') %></th><th class="text-end"><%= t('billing.unit_price') %></th><th class="text-end"><%= t('billing.amount') %></th></tr></thead>
      <tbody><% i.items.forEach(function (it) { %><tr><td><%= it.description %></td><td class="text-end num"><%= it.quantity %></td><td class="text-end num"><%= fmt.money(it.unit_price, i.currency) %></td><td class="text-end num"><%= fmt.money(it.amount, i.currency) %></td></tr><% }) %></tbody>
    </table></div>
    <dl class="dl" style="margin-inline-start:auto;max-width:320px;grid-template-columns:1fr auto">
      <dt><%= t('billing.subtotal') %></dt><dd class="num text-end"><%= fmt.money(i.subtotal, i.currency) %></dd>
      <dt><%= t('billing.vat_line', { rate: i.tax_rate }) %></dt><dd class="num text-end"><%= fmt.money(i.tax, i.currency) %></dd>
      <dt style="font-weight:700;color:var(--text)"><%= t('billing.total') %></dt><dd class="num text-end" style="font-weight:800;font-size:18px"><%= fmt.money(i.total, i.currency) %></dd>
    </dl>
    <% if (i.status === 'issued' && !(gateways.length && can('billing.manage'))) { %><div class="alert alert-info"><%- icon('info') %><div class="grow small"><%= t('billing.payment_instructions') %></div></div><% } %>
    <% if (i.status === 'paid') { %><p class="muted small"><%= t('billing.paid_on', { date: fmt.date(i.paid_at) }) %><%= i.payment_reference ? ' · ' + i.payment_reference : '' %></p><% } %>
  </div>
</section>
<% if (attempts && attempts.length) { %>
<section class="panel mt-6 no-print" style="max-width:860px">
  <div class="panel-head"><h2><%= t('payments.attempts') %></h2></div>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('billing.date') %></th><th><%= t('payments.gateway') %></th><th class="text-end"><%= t('billing.amount') %></th><th><%= t('fields.status') %></th></tr></thead>
    <tbody><% attempts.forEach(function (a) { %><tr>
      <td class="nowrap"><%= fmt.date(a.created_at, { dateStyle: 'medium', timeStyle: 'short' }) %></td>
      <td><%= ({ moyasar: 'Moyasar', tap: 'Tap Payments', hyperpay: 'HyperPay', paytabs: 'PayTabs' })[a.provider] || a.provider %><%= a.method ? ' · ' + t('payments.method_' + a.method) : '' %></td>
      <td class="text-end num"><%= fmt.money(a.amount, a.currency) %></td>
      <td><span class="st st-<%= a.status === 'paid' ? 'approved' : a.status === 'initiated' ? 'pending' : 'rejected' %>"><%= t('payments.status_' + a.status) %></span><% if (a.failure_reason && a.status !== 'paid') { %> <span class="muted small" dir="ltr"><%= a.failure_reason.slice(0, 80) %></span><% } %></td>
    </tr><% }) %></tbody>
  </table></div>
</section>
<% } %>
