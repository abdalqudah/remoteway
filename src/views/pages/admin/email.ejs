<% var s = saved || {}; %>
<div class="page-head"><div><h1><%= t('admin.email') %></h1><p><%= t('admin.email_sub') %></p></div><div class="page-actions"><a class="btn btn-secondary" href="/admin/email/log"><%- icon('history') %><%= t('maillog.title') %></a></div></div>
<div class="alert <%= source ? 'alert-success' : 'alert-warning' %> mb-6"><%- icon(source ? 'circle-check' : 'triangle-alert') %><div>
  <div class="alert-title"><%= source === 'admin' ? t('admin.email_on_admin') : source === 'env' ? t('admin.email_on_env') : t('admin.email_off') %></div>
  <div class="small text-2"><%= t('admin.email_used_for') %></div></div></div>
<%- include('../../partials/smtp-result') %>
<div class="grid grid-3 align-start">
  <div class="span-2"><%- include('../../partials/smtp-form', { base: '/admin/email', cfg: saved, testTo: currentUser.email, showClear: Boolean(saved) }) %></div>
  <section class="panel"><div class="panel-head"><h2><%= t('smtp.guide_title') %></h2></div><div class="panel-body small text-2 stack-sm">
    <p><strong><%= t('smtp.p_gmail') %>:</strong> <%= t('smtp.g_gmail') %></p>
    <p><strong><%= t('smtp.p_google_relay') %>:</strong> <%= t('smtp.g_google_relay') %></p>
    <p><strong><%= t('smtp.p_microsoft365') %>:</strong> <%= t('smtp.g_microsoft365') %></p>
    <p><strong><%= t('smtp.p_cpanel') %>:</strong> <%= t('smtp.g_cpanel') %></p>
    <p><%= t('smtp.g_env') %></p>
  </div></section>
</div>
<%- include('../../partials/smtp-events') %>
<form class="panel mt-6" method="post" action="/admin/email/policy">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="panel-head"><div><h2><%- icon('building-2') %> <%= t('orgmail.policy_title') %></h2><div class="panel-sub"><%= t('orgmail.policy_sub', { connected: connected, companies: companies }) %></div></div></div>
  <div class="panel-body stack">
    <label class="check"><input type="checkbox" name="require_company_email" value="1"<%= requireCompany ? ' checked' : '' %>><span><%= t('orgmail.policy_require') %></span></label>
    <p class="small muted"><%= t('orgmail.policy_help') %></p>
  </div>
  <div class="panel-foot"><button class="btn btn-dark" type="submit"><%= t('common.save_changes') %></button></div>
</form>
