<% var i = doc.invoice; %>
<div class="page-head">
  <div><div class="eyebrow"><a href="/admin/invoices"><%= t('admin.invoices') %></a><%- icon('chevron-right', 'icon-sm flip-rtl') %></div>
    <h1><%= t('billing.invoice') %> <span class="mono" dir="ltr"><%= i.number %></span></h1>
    <p><a class="link" href="/admin/organizations/<%= i.organization_id %>"><%= doc.org.name %></a> · <span class="num"><%= fmt.money(i.total, i.currency) %></span> · <span class="badge badge-dot <%= i.status === 'paid' ? 'badge-success' : 'badge-warning' %>"><%= t('billing.invoice_' + i.status) %></span></p></div>
  <div class="page-actions"><a class="btn btn-secondary" href="<%= doc.link %>" target="_blank" rel="noopener"><%- icon('external-link') %><%= t('sales.view_as_customer') %></a></div>
</div>
<div class="grid grid-3 align-start">
  <div class="span-2"><%- include('../../../partials/sales/send-panel', { base: '/admin/invoices/' + i.id }) %></div>
  <div class="stack">
    <section class="panel"><div class="panel-head"><h2><%- icon('eye') %> <%= t('sales.tracking') %></h2></div><div class="panel-body"><dl class="dl small">
      <dt><%= t('sales.views') %></dt><dd class="num"><%= i.view_count || 0 %></dd>
      <dt><%= t('sales.last_viewed') %></dt><dd><%= i.last_viewed_at ? fmt.date(i.last_viewed_at, { dateStyle: 'medium', timeStyle: 'short' }) : t('sales.not_yet') %></dd>
    </dl></div></section>
    <%- include('../../../partials/sales/sends', { sends: sends }) %>
  </div>
</div>
