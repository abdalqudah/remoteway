<%
  var tf = function (v) { return v ? new Intl.DateTimeFormat(locale === 'ar' ? 'ar-SA-u-nu-latn' : 'en-GB', { hour: '2-digit', minute: '2-digit', timeZone: sheet.tz }).format(new Date(v)) : '—'; };
  var local = function (v) { return v ? new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: sheet.tz }).format(new Date(v)) : ''; };
  var shift = function (n) { var x = new Date(sheet.date + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };
  var s = sheet.summary;
%>
<div class="page-head">
  <div><h1><%= t('nav.attendance') %></h1><p><%= fmt.date(sheet.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %><%= sheet.isWorkingDay ? '' : ' · ' + t('attendance.day_off') %></p></div>
  <form class="page-actions" method="get">
    <a class="btn btn-secondary btn-icon" href="?date=<%= shift(-1) %>" aria-label="<%= t('table.prev') %>"><%- icon('chevron-left', 'flip-rtl') %></a>
    <input class="input" type="date" name="date" value="<%= sheet.date %>" style="width:auto" aria-label="<%= t('billing.date') %>">
    <a class="btn btn-secondary btn-icon" href="?date=<%= shift(1) %>" aria-label="<%= t('table.next') %>"><%- icon('chevron-right', 'flip-rtl') %></a>
    <button class="btn btn-secondary" type="submit"><%= t('common.apply') %></button>
    <% if (can('attendance.manage')) { %><a class="btn btn-dark" href="/app/attendance/qr"><%- icon('smartphone') %><%= t('qr.title') %></a><% } %>
  </form>
</div>

<% if (today) { %><div class="mb-6"><%- include('../../partials/clock-widget', { today: today }) %></div><% } %>

<div class="summary-strip mb-4">
  <% ['present', 'late', 'absent', 'on_leave', 'not_yet', 'off'].forEach(function (k) { if (k === 'off' && !s.off) return; %>
    <span class="chip"><span class="st st-<%= k %>"><%= t('attendance.status_' + k) %></span><strong><%= fmt.number(s[k] || 0) %></strong></span>
  <% }) %>
</div>

<section class="panel">
  <% if (!sheet.rows.length) { %><div class="empty"><span class="empty-icon"><%- icon('users') %></span><p><%= t('attendance.no_people') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('fields.name') %></th><th><%= t('fields.department') %></th><th><%= t('fields.status') %></th><th><%= t('attendance.clock_in') %></th><th><%= t('attendance.clock_out') %></th><th class="text-end"><%= t('attendance.worked') %></th><th class="actions"></th></tr></thead>
    <tbody><% sheet.rows.forEach(function (p) { var r = p.record; %>
      <tr>
        <td><a class="person" href="/app/attendance/employees/<%= p.id %>"><span class="avatar"><%= initials(p.first_name + ' ' + p.last_name) %></span><span><span class="person-name"><%= p.first_name %> <%= p.last_name %></span><span class="person-sub" style="display:block"><%= p.job_title || p.employee_number %></span></span></a></td>
        <td class="muted"><%= p.department_name || '—' %></td>
        <td><span class="st st-<%= p.status %>"><%= t('attendance.status_' + p.status) %></span><% if (r && r.late_minutes > 0) { %> <span class="muted tiny">+<%= r.late_minutes %> <%= t('attendance.min') %></span><% } %></td>
        <td class="num"><%= tf(r && r.clock_in) %><% if (r && r.clock_in_method === 'qr') { %> <span class="qr-tag">QR</span><% } %></td>
        <td class="num"><%= tf(r && r.clock_out) %><% if (r && r.clock_out_method === 'qr') { %> <span class="qr-tag">QR</span><% } %></td>
        <td class="text-end num"><%= r && r.clock_out ? Math.floor(r.worked_minutes / 60) + ':' + String(r.worked_minutes % 60).padStart(2, '0') : '—' %></td>
        <td class="actions"><% if (can('attendance.manage')) { %><button class="btn btn-ghost btn-sm" type="button" data-open-dialog="manual-dialog" data-fill="<%= JSON.stringify({ employee_id: p.id, work_date: sheet.date, clock_in: local(r && r.clock_in) || '09:00', clock_out: local(r && r.clock_out), break_minutes: r ? r.break_minutes : 0, note: (r && r.note) || '' }) %>"><%- icon('pencil', 'icon-sm') %><%= t('attendance.correct') %></button><% } %></td>
      </tr>
    <% }) %></tbody>
  </table></div><% } %>
</section>
<%- include('../../partials/attendance-manual') %>
