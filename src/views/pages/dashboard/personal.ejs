<div class="page-head">
  <div><div class="eyebrow"><%= organization.name %></div><h1><%= t('dashboard.greeting', { name: currentUser.name.split(' ')[0] }) %></h1><p><%= t('dashboard.personal_subtitle') %></p></div>
</div>
<div class="grid grid-3">
  <section class="panel span-2">
    <div class="panel-head"><h2><%= t('dashboard.my_profile') %></h2></div>
    <% if (!me) { %>
      <div class="empty"><span class="empty-icon"><%- icon('user') %></span><h3><%= t('dashboard.not_linked_title') %></h3><p><%= t('dashboard.not_linked_text') %></p></div>
    <% } else { %>
      <div class="panel-body">
        <div class="row mb-4"><span class="avatar avatar-lg"><%= initials(me.first_name + ' ' + me.last_name) %></span><div><div style="font-weight:700;font-size:16px"><%= me.first_name %> <%= me.last_name %></div><div class="muted"><%= me.job_title || '—' %></div></div></div>
        <dl class="dl">
          <dt><%= t('fields.employee_number') %></dt><dd class="num"><%= me.employee_number %></dd>
          <dt><%= t('fields.department') %></dt><dd><%= me.department_name || '—' %></dd>
          <dt><%= t('fields.manager') %></dt><dd><%= me.manager_name || '—' %></dd>
          <dt><%= t('fields.location') %></dt><dd><%= me.location_name || '—' %></dd>
          <dt><%= t('fields.joining_date') %></dt><dd><%= fmt.date(me.joining_date) %></dd>
        </dl>
      </div>
    <% } %>
  </section>
  <section class="panel">
    <div class="panel-head"><div><h2><%= t('dashboard.self_service') %></h2><div class="panel-sub"><%= t('dashboard.self_service_sub') %></div></div></div>
    <ul class="action-list">
      <% [['leave', 'plane'], ['attendance', 'calendar-check'], ['payroll', 'wallet'], ['documents', 'file-text'], ['learning', 'graduation-cap']].forEach(function (m) { var mod = MODULES.find(function (x) { return x.key === m[0]; }); %>
        <li><a href="/app/modules/<%= m[0] %>"><span class="action-icon"><%- icon(m[1], 'icon-sm') %></span><span class="grow small"><%= t('nav.' + m[0]) %></span><span class="badge badge-soon"><%= t('common.phase', { n: mod.phase }) %></span></a></li>
      <% }) %>
    </ul>
  </section>
</div>
<% if (team) { %>
<section class="panel mt-6">
  <div class="panel-head"><div><h2><%= t('dashboard.my_team') %></h2><div class="panel-sub"><%= t('dashboard.team_count', { n: fmt.number(team.meta.total) }) %></div></div><a class="btn btn-ghost btn-sm" href="/app/employees"><%= t('common.view_all') %></a></div>
  <% if (!team.data.length) { %><div class="empty"><p><%= t('dashboard.no_reports') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table"><tbody>
    <% team.data.forEach(function (e) { %><tr><td><a class="person" href="/app/employees/<%= e.id %>"><span class="avatar"><%= initials(e.full_name) %></span><span><span class="person-name"><%= e.full_name %></span><span class="person-sub" style="display:block"><%= e.job_title || '—' %></span></span></a></td><td class="muted"><%= e.department_name || '—' %></td><td><%- include('../../partials/status-badge', { status: e.status }) %></td></tr><% }) %>
  </tbody></table></div><% } %>
</section>
<% } %>
