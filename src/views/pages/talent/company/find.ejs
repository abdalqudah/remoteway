<%- include('_tabs') %>
<form class="filter-bar mb-4" method="get" action="/app/talent">
  <input class="input" type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('talent.search_people_ph') %>" aria-label="<%= t('common.search') %>">
  <select class="select" name="specialization" aria-label="<%= t('talent.specialization') %>"><option value=""><%= t('talent.any_specialization') %></option><% specs.forEach(function (s) { %><option value="<%= s.specialization %>"<%= filters.specialization === s.specialization ? ' selected' : '' %>><%= s.specialization %> (<%= s.n %>)</option><% }) %></select>
  <input class="input" name="skills" value="<%= filters.skills || '' %>" placeholder="<%= t('talent.skills_ph') %>" aria-label="<%= t('talent.skills') %>">
  <select class="select" name="min_years" aria-label="<%= t('talent.min_experience') %>"><option value=""><%= t('talent.any_experience') %></option><% [1,2,3,5,8,10].forEach(function (n) { %><option value="<%= n %>"<%= String(filters.min_years) === String(n) ? ' selected' : '' %>><%= t('talent.years_plus', { n: n }) %></option><% }) %></select>
  <input class="input" name="city" value="<%= filters.city || '' %>" placeholder="<%= t('fields.city') %>" aria-label="<%= t('fields.city') %>">
  <select class="select" name="work_mode" aria-label="<%= t('talent.work_mode') %>"><option value=""><%= t('talent.any_mode') %></option><% ['remote','hybrid','onsite'].forEach(function (m) { %><option value="<%= m %>"<%= filters.work_mode === m ? ' selected' : '' %>><%= t('recruitment.mode_' + m) %></option><% }) %></select>
  <select class="select" name="job_type" aria-label="<%= t('talent.job_type') %>"><option value=""><%= t('talent.any_type') %></option><% ['full_time','part_time','contract','freelance','intern'].forEach(function (m) { %><option value="<%= m %>"<%= filters.job_type === m ? ' selected' : '' %>><%= t('recruitment.type_' + m) %></option><% }) %></select>
  <input class="input" name="language" value="<%= filters.language || '' %>" placeholder="<%= t('talent.language') %>" aria-label="<%= t('talent.language') %>">
  <label class="check"><input type="checkbox" name="open" value="1"<%= filters.open_to_work ? ' checked' : '' %>><%= t('talent.open_only') %></label>
  <button class="btn btn-dark" type="submit"><%- icon('search', 'icon-sm') %><%= t('common.search') %></button>
</form>
<div class="alert alert-info mb-4"><%- icon('sparkles') %><div class="grow small"><%= t('talent.try_ai') %></div><a class="btn btn-dark btn-sm" href="/app/talent/ai"><%= t('talent.tab_ai') %></a></div>
<p class="muted small mb-4"><%= t('talent.people_found', { n: result.total }) %></p>
<% if (!result.items.length) { %><div class="empty"><span class="empty-icon"><%- icon('users') %></span><p><%= t('talent.no_people') %></p></div>
<% } else { %><div class="card-grid"><% result.items.forEach(function (p) { %>
  <div class="stack-sm"><%- include('../../../partials/talent/person-card', { p: p, link: '/app/talent/p/' + p.id }) %><%- include('_actions', { p: p }) %></div>
<% }) %></div><%- include('../../../partials/talent/pager', { total: result.total, page: result.page, perPage: result.perPage }) %><% } %>
