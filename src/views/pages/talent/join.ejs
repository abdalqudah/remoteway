<h1><%= t('talent.join_title') %></h1>
<p class="lead"><%= t('talent.join_lead') %></p>
<form method="post" action="/join" class="mt-6 stack" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? (old && old.next) || next : '' %>">
  <% if (formError && formError.code === 'EMAIL_TAKEN') { %><div class="alert alert-warning"><%- icon('info') %><div class="grow small"><%= formError.message %> <a href="/login"><%= t('auth.login') %></a></div></div><% } %>
  <%- include('../../partials/field', { name: 'name', label: t('fields.full_name'), required: true, autocomplete: 'name' }) %>
  <%- include('../../partials/field', { name: 'email', label: t('fields.email'), type: 'email', required: true, autocomplete: 'email' }) %>
  <%- include('../../partials/field', { name: 'password', label: t('fields.password'), type: 'password', required: true, autocomplete: 'new-password', help: t('auth.password_help'), attrs: 'minlength="8"' }) %>
  <label class="check"><input type="checkbox" name="terms"><span><%= t('legal.accept_pre') %> <a class="link" href="/terms" target="_blank" rel="noopener"><%= t('legal.terms_title') %></a> <%= t('legal.and') %> <a class="link" href="/privacy" target="_blank" rel="noopener"><%= t('legal.privacy_title') %></a>.</span></label>
  <% if (errors && errors.terms) { %><span class="field-error"><%= errors.terms %></span><% } %>
  <button class="btn btn-dark btn-lg btn-block" type="submit"><%= t('talent.join_cta') %></button>
  <%- include('../../partials/google-button', { gIntent: 'join', gNext: typeof next !== 'undefined' ? next : '' }) %>
  <p class="small muted"><%= typeof googleOn !== 'undefined' && googleOn ? t('google.join_terms') : '' %></p>
  <p class="muted small text-center"><%= t('talent.join_company_q') %> <a href="/signup"><%= t('talent.join_company_link') %></a> · <a href="/login"><%= t('auth.login') %></a></p>
</form>
