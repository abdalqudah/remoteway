<%
  var proc = can('payroll.process');
  var cur = organization.currency;
  var monthName = function (p) { return fmt.date(p + '-01', { month: 'long', year: 'numeric' }); };
  var last = runs.find(function (r) { return r.status !== 'cancelled'; });
%>
<div class="page-head">
  <div><h1><%= t('nav.payroll') %></h1><p><%= t('payroll.subtitle') %></p></div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/app/payroll/settings"><%- icon('settings') %><%= t('payroll.settings') %></a>
    <% if (proc) { %><button class="btn btn-dark" type="button" data-open-dialog="run-dialog"<%= months.length ? '' : ' disabled' %>><%- icon('plus') %><%= t('payroll.new_run') %></button><% } %>
  </div>
</div>

<% if (!rules.hasStatutory) { %><div class="alert alert-info mb-4"><%- icon('info') %><div><%= t('payroll.no_statutory', { country: locale === 'ar' ? (organization.country_name_ar || organization.country_code) : (organization.country_name || organization.country_code) }) %></div></div><% } %>

<div class="kpis mb-6">
  <div class="kpi"><div class="kpi-label"><%= t('payroll.kpi_last_net') %></div><div class="kpi-value"><%= last ? fmt.money(last.total_net, last.currency) : '—' %></div><div class="kpi-meta"><%= last ? monthName(last.period) + ' · ' + t('payroll.status_' + last.status) : t('payroll.kpi_no_runs') %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('payroll.kpi_employer_cost') %></div><div class="kpi-value"><%= last ? fmt.money(Number(last.total_gross) + Number(last.total_employer), last.currency) : '—' %></div><div class="kpi-meta"><%= t('payroll.kpi_employer_cost_sub') %></div></div>
  <div class="kpi"><div class="kpi-label"><%= t('payroll.kpi_ready') %></div><div class="kpi-value"><%= fmt.number(readiness.employees - readiness.noSalary) %><span class="muted" style="font-size:16px"> / <%= fmt.number(readiness.employees) %></span></div><div class="kpi-meta"><%= t('payroll.kpi_ready_sub') %></div></div>
</div>

<div class="grid grid-3">
  <section class="panel span-2">
    <div class="panel-head"><h2><%= t('payroll.runs') %></h2></div>
    <% if (!runs.length) { %>
      <div class="empty"><span class="empty-icon"><%- icon('wallet') %></span><h3><%= t('payroll.empty_title') %></h3><p><%= t('payroll.empty_text') %></p>
        <% if (proc && months.length) { %><button class="btn btn-dark mt-4" type="button" data-open-dialog="run-dialog"><%- icon('plus') %><%= t('payroll.new_run') %></button><% } %></div>
    <% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= t('payroll.period') %></th><th><%= t('fields.status') %></th><th class="num"><%= t('payroll.employees') %></th><th class="num"><%= t('payroll.gross') %></th><th class="num"><%= t('payroll.net') %></th><th></th></tr></thead>
      <tbody><% runs.forEach(function (r) { %>
        <tr<%= r.status === 'cancelled' ? ' class="muted"' : '' %>>
          <td><a class="person-name" href="/app/payroll/runs/<%= r.id %>"><%= monthName(r.period) %></a></td>
          <td><span class="st st-<%= r.status %>"><%= t('payroll.status_' + r.status) %></span></td>
          <td class="num"><%= fmt.number(r.employee_count) %></td>
          <td class="num nowrap"><%= fmt.amount(r.total_gross, r.currency) %></td>
          <td class="num nowrap"><strong><%= fmt.amount(r.total_net, r.currency) %></strong> <span class="tiny muted"><%= r.currency %></span></td>
          <td class="text-end"><a class="btn btn-secondary btn-sm" href="/app/payroll/runs/<%= r.id %>"><%= t('recruitment.open') %></a></td>
        </tr>
      <% }) %></tbody>
    </table></div>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head"><div><h2><%= t('payroll.readiness') %></h2><div class="panel-sub"><%= t('payroll.readiness_sub') %></div></div></div>
    <% if (!missingSalary.length && !missingIban.length) { %>
      <div class="empty" style="padding:28px"><span class="empty-icon" style="background:var(--success-soft);color:var(--success)"><%- icon('circle-check') %></span><p><%= t('payroll.all_ready') %></p></div>
    <% } else { %>
    <ul class="action-list">
      <% missingSalary.slice(0, 6).forEach(function (e) { %><li><a href="/app/employees/<%= e.id %>?tab=payroll"><span class="action-icon danger"><%- icon('wallet', 'icon-sm') %></span><span class="grow small"><%= e.first_name %> <%= e.last_name %><span class="muted" style="display:block"><%= t('payroll.missing_salary') %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
      <% missingIban.filter(function (e) { return !missingSalary.some(function (m) { return m.id === e.id; }); }).slice(0, 6).forEach(function (e) { %><li><a href="/app/employees/<%= e.id %>?tab=payroll"><span class="action-icon warning"><%- icon('credit-card', 'icon-sm') %></span><span class="grow small"><%= e.first_name %> <%= e.last_name %><span class="muted" style="display:block"><%= t('payroll.missing_iban') %></span></span><%- icon('chevron-right', 'icon-sm muted flip-rtl') %></a></li><% }) %>
    </ul>
    <div class="panel-foot small muted"><%= t('payroll.readiness_counts', { salary: readiness.noSalary, iban: readiness.noIban }) %></div>
    <% } %>
  </section>
</div>

<% if (proc) { %>
<dialog class="dialog" id="run-dialog"<%= openDialog === 'run' ? ' data-open-on-load' : '' %>>
  <form method="post" action="/app/payroll/runs" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="dialog-head"><div><h2><%= t('payroll.new_run') %></h2><p class="muted small mt-1"><%= t('payroll.new_run_sub') %></p></div><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <% if (formError) { %><div class="alert alert-error"><%= Object.values(errors)[0] || formError.message %></div><% } %>
      <%- include('../../partials/field', { name: 'period', label: t('payroll.period'), type: 'select', required: true, value: months[1] || months[0], options: months.map(function (p) { return { value: p, label: monthName(p) }; }) }) %>
      <p class="help"><%= t('payroll.new_run_help') %></p>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-dark" type="submit"><%= t('payroll.calculate') %></button></div>
  </form>
</dialog>
<% } %>
