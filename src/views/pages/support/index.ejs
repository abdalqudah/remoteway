<% var o = old || {}; %>
<div class="page-head"><div><h1><%= t('support.title') %></h1><p><%= t('support.sub') %></p></div>
  <div class="page-actions"><button class="btn btn-dark" type="button" data-open-dialog="ticket-dialog"><%- icon('plus') %><%= t('support.new') %></button></div></div>

<div class="alert <%= tier === 'priority' ? 'alert-success' : 'alert-info' %> mb-6"><%- icon(tier === 'priority' ? 'badge-check' : 'info') %><div>
  <div class="alert-title"><%= tier === 'priority' ? t('support.tier_priority') : t('support.tier_standard') %></div>
  <div class="small text-2"><%= t('support.sla_line', { urgent: SLA[tier].urgent, high: SLA[tier].high, normal: SLA[tier].normal, low: SLA[tier].low }) %><% if (tier !== 'priority') { %> <%= t('support.priority_upsell') %><% } %></div></div></div>

<section class="panel">
  <% if (!tickets.length) { %><div class="empty"><span class="empty-icon"><%- icon('life-buoy') %></span><p><%= t('support.empty') %></p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= t('support.subject') %></th><th><%= t('support.category') %></th><th><%= t('support.priority') %></th><th><%= t('fields.status') %></th><th><%= t('support.updated') %></th></tr></thead>
    <tbody><% tickets.forEach(function (tk) { %>
      <tr><td><a class="link" href="/app/support/<%= tk.id %>"><strong>#<%= tk.id %> · <%= tk.subject %></strong></a><div class="muted tiny"><%= tk.created_by_name || '' %></div></td>
        <td><%= t('support.cat_' + tk.category) %></td><td><span class="st st-prio-<%= tk.priority %>"><%= t('support.prio_' + tk.priority) %></span></td>
        <td><span class="st st-t-<%= tk.status %>"><%= t('support.status_' + tk.status) %></span></td>
        <td class="muted nowrap"><%= fmt.date(tk.last_activity_at, { dateStyle: 'medium', timeStyle: 'short' }) %></td></tr>
    <% }) %></tbody>
  </table></div><% } %>
</section>

<dialog class="dialog" id="ticket-dialog"<%= openDialog === 'ticket-dialog' ? ' data-open-on-load' : '' %>>
  <form method="post" action="/app/support" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="dialog-head"><h2><%= t('support.new') %></h2><button class="btn btn-ghost btn-icon btn-sm" type="button" data-close-dialog aria-label="<%= t('common.close') %>"><%- icon('x') %></button></div>
    <div class="dialog-body stack">
      <%- include('../../partials/field', { name: 'subject', label: t('support.subject'), required: true, value: o.subject }) %>
      <div class="form-grid">
        <%- include('../../partials/field', { name: 'category', label: t('support.category'), type: 'select', value: o.category || 'technical', options: CATEGORIES.map(function (c) { return { value: c, label: t('support.cat_' + c) }; }) }) %>
        <%- include('../../partials/field', { name: 'priority', label: t('support.priority'), type: 'select', value: o.priority || 'normal', options: PRIORITIES.map(function (p) { return { value: p, label: t('support.prio_' + p) + ' — ' + t('support.within_h', { h: SLA[tier][p] }) }; }) }) %>
      </div>
      <%- include('../../partials/field', { name: 'body', label: t('support.message'), type: 'textarea', required: true, value: o.body, help: t('support.message_help') }) %>
    </div>
    <div class="dialog-foot"><button class="btn btn-ghost" type="button" data-close-dialog><%= t('common.cancel') %></button><button class="btn btn-dark" type="submit"><%- icon('send') %><%= t('support.send') %></button></div>
  </form>
</dialog>
